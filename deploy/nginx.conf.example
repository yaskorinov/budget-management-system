# /etc/nginx/sites-available/budget-bot
# Домен нужен обязательно: Telegram требует https и для вебхука, и для мини-аппы.

server {
    listen 80;
    listen [::]:80;
    server_name budget.example.com;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name budget.example.com;

    ssl_certificate     /etc/letsencrypt/live/budget.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/budget.example.com/privkey.pem;

    client_max_body_size 2m;

    # Диаграммы для inline-режима: их забирает Telegram, кэш здесь уместен.
    location /charts/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_cache_valid 200 10m;
        add_header Cache-Control "public, max-age=600";
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }
}
