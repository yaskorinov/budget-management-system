# ---------- Telegram ----------
# Токен от @BotFather
BOT_TOKEN=123456:ABCdefGhIJKlmNoPQRsTUVwxyZ
# polling — для локальной разработки; webhook — для VPS с доменом и HTTPS
BOT_MODE=polling
# Секрет для проверки апдейтов вебхука (любая случайная строка)
WEBHOOK_SECRET=change-me-webhook-secret

# ---------- Сервер ----------
HOST=127.0.0.1
PORT=8080
# Публичный адрес сервиса. Нужен для: вебхука, мини-аппы,
# картинок диаграмм в inline-режиме. Обязательно https для Telegram.
PUBLIC_BASE_URL=
# Секрет для подписи сессионных токенов веба (openssl rand -hex 32)
SECRET_KEY=change-me-please-openssl-rand-hex-32

# ---------- Яндекс ID ----------
# Вход в браузере без Telegram. Приложение заводится на oauth.yandex.ru,
# Redirect URI — {PUBLIC_BASE_URL}/auth/yandex/callback, права: доступ к логину
# и адресу почты. Пусто — кнопки входа через Яндекс просто не будет.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ---------- Запуск ----------
# Compose читает эту переменную из .env, поэтому оверлеи можно не набирать
# руками при каждом запуске: обычный docker compose up подхватит их сам.
# Нужна там, где прокси слушает loopback хоста и контейнеру нужна сеть хоста.
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.proxy.yml

# ---------- Прокси ----------
# Выходной socks5 (или http) прокси. Пусто — идём напрямую.
# PROXY_URL применяется ко всему исходящему трафику, LLM_PROXY_URL перекрывает
# его для запросов к модели: чаще всего прокси нужен только ей.
# Для socks5 нужны пакеты aiohttp-socks и httpx[socks] — они есть в requirements.
# socks5h вместо socks5 заставит резолвить домены на стороне прокси.
# Бот в Docker, а прокси на хосте: если прокси слушает все интерфейсы или
# адрес docker-моста, пишите host.docker.internal вместо 127.0.0.1. Если он
# слушает только loopback хоста, оставляйте 127.0.0.1 и поднимайте бота
# оверлеем deploy/docker-compose.proxy.yml — он даёт контейнеру сеть хоста.
PROXY_URL=
LLM_PROXY_URL=

# ---------- База ----------
DATABASE_URL=sqlite+aiosqlite:///./data/expenses.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/expenses

# ---------- Локаль ----------
# Часовой пояс для границ периодов и отображения дат (смещение от UTC в часах)
TZ_OFFSET_HOURS=3
CURRENCY=RUB

# ---------- LLM ----------
# openai_compat  — любой OpenAI-совместимый эндпоинт: OpenRouter, OpenAI,
#                  прокси, локальный vLLM/Ollama (/v1/chat/completions)
# anthropic      — официальное API Anthropic (SDK)
# off            — только словарь ключевых слов, без сети
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=  # ключ из https://aistudio.google.com/apikey
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=8

# Расшифровка голосовых. У Gemini аудио принимает и flash-lite, поэтому здесь
# та же модель. Отдельная нужна там, где основная не умеет аудио —
# например nvidia/nemotron-3.5-lightning:free у OpenRouter
LLM_VOICE_MODEL=gemini-3.1-flash-lite
LLM_VOICE_TIMEOUT_SECONDS=60

# ---------- Ежедневные сообщения ----------
# Часы по локальному времени (TZ_OFFSET_HOURS). -1 — выключить.
TIPS_HOUR=20    # совет по оптимизации расходов
DEBTS_HOUR=12   # напоминание о задолженностях
