# ---------- Telegram ----------
# Токен от @BotFather
BOT_TOKEN=123456:ABCdefGhIJKlmNoPQRsTUVwxyZ
# polling — для локальной разработки; webhook — для VPS с доменом и HTTPS
BOT_MODE=polling
# Секрет для проверки апдейтов вебхука (любая случайная строка)
WEBHOOK_SECRET=change-me-webhook-secret

# ---------- Сервер ----------
HOST=127.0.0.1
PORT=8080
# Публичный адрес сервиса. Нужен для: вебхука, мини-аппы,
# картинок диаграмм в inline-режиме. Обязательно https для Telegram.
PUBLIC_BASE_URL=
# Секрет для подписи сессионных токенов веба (openssl rand -hex 32)
SECRET_KEY=change-me-please-openssl-rand-hex-32

# ---------- База ----------
DATABASE_URL=sqlite+aiosqlite:///./data/expenses.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/expenses

# ---------- Локаль ----------
# Часовой пояс для границ периодов и отображения дат (смещение от UTC в часах)
TZ_OFFSET_HOURS=3
CURRENCY=RUB

# ---------- LLM-категоризация ----------
# anthropic       — официальное API Anthropic (SDK)
# openai_compat   — любой OpenAI-совместимый эндпоинт: OpenAI, OpenRouter,
#                   прокси, локальный vLLM/Ollama (/v1/chat/completions)
# off             — только словарь ключевых слов, без сети
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5
# Дешевле и быстрее для классификации: claude-haiku-4-5
# Для openai_compat укажите базовый URL, например https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=8
